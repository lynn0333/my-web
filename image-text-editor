<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IMG TEXT REWRITE - 图片文字替换</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#050c18;--bg2:#0b1628;--bg3:#101f38;--bg4:#07111f;
  --accent:#00d4ff;--accent2:#0088ff;--success:#00ffaa;--warn:#ffb040;--danger:#ff4466;
  --text:#e0eeff;--text2:#8aaac8;--text3:#3d5a78;
  --border:rgba(0,212,255,.18);--borderB:rgba(0,212,255,.55);
  --glow:0 0 16px rgba(0,212,255,.35);
  --mono:'Share Tech Mono',monospace;--head:'Rajdhani',sans-serif;--body:'Noto Sans SC',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
body{min-height:100vh;background:var(--bg);color:var(--text);font-family:var(--body);overflow-x:hidden}
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:
    linear-gradient(rgba(0,212,255,.04) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,212,255,.04) 1px,transparent 1px);
  background-size:48px 48px;
}
.app{position:relative;z-index:2;max-width:1480px;margin:0 auto;padding:0 24px 46px}
header{padding:24px 0 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
.logo-main{font-family:var(--head);font-size:26px;font-weight:700;letter-spacing:5px;color:var(--accent);text-shadow:0 0 12px rgba(0,212,255,.5)}
.logo-sub{font-family:var(--mono);font-size:11px;color:var(--text2);letter-spacing:3px;margin-top:3px}
.hdr-right{display:flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:flex-end}
.live-dot{display:flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;color:var(--text2)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--success);box-shadow:0 0 7px var(--success);animation:blink 2.2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
.badge{font-family:var(--mono);font-size:10px;padding:3px 9px;border-radius:2px;background:rgba(0,212,255,.1);border:1px solid var(--border);color:var(--text2);letter-spacing:1px}
.workspace{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:20px;align-items:start}
@media(max-width:1050px){.workspace{grid-template-columns:1fr}.side-panel{max-height:none!important}}
.panel{background:var(--bg2);border:1px solid var(--border);border-radius:4px;position:relative;overflow:hidden}
.panel::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--accent),transparent);opacity:.4}
.c{position:absolute;width:10px;height:10px;border-color:var(--accent);border-style:solid;opacity:.35;pointer-events:none}
.c-tl{top:0;left:0;border-width:1px 0 0 1px}.c-tr{top:0;right:0;border-width:1px 1px 0 0}
.c-bl{bottom:0;left:0;border-width:0 0 1px 1px}.c-br{bottom:0;right:0;border-width:0 1px 1px 0}
.ph{padding:10px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;background:rgba(0,212,255,.04)}
.ph-title{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--accent);display:flex;align-items:center;gap:6px}
.ph-title::before{content:'//';color:var(--text3)}
.toolbar{display:flex;align-items:center;gap:8px;padding:14px 16px;border-bottom:1px solid var(--border);flex-wrap:wrap}
.btn{font-family:var(--mono);font-size:11px;letter-spacing:1px;padding:8px 15px;background:rgba(0,212,255,.07);border:1px solid var(--borderB);color:var(--accent);border-radius:3px;cursor:pointer;transition:all .18s;display:flex;align-items:center;justify-content:center;gap:7px;white-space:nowrap;text-decoration:none;min-height:34px}
.btn:hover{background:rgba(0,212,255,.18);box-shadow:var(--glow)}
.btn:active{transform:scale(.97)}
.btn:disabled{opacity:.32;pointer-events:none}
.btn.ok{border-color:rgba(0,255,170,.45);color:var(--success);background:rgba(0,255,170,.07)}
.btn.ok:hover{background:rgba(0,255,170,.18);box-shadow:0 0 14px rgba(0,255,170,.3)}
.btn.warn{border-color:rgba(255,176,64,.45);color:var(--warn);background:rgba(255,176,64,.07)}
.btn.danger{border-color:rgba(255,68,102,.45);color:var(--danger);background:rgba(255,68,102,.07)}
.modes{display:flex;border:1px solid var(--border);border-radius:3px;overflow:hidden}
.mode-btn{padding:8px 13px;font-family:var(--mono);font-size:10px;letter-spacing:1px;background:transparent;border:0;color:var(--text2);cursor:pointer;transition:all .2s}
.mode-btn.on{background:rgba(0,212,255,.16);color:var(--accent)}
.canvas-zone{padding:16px}
.canvas-wrap{position:relative;min-height:520px;border:1px solid var(--border);border-radius:3px;background:#020810;overflow:auto;display:flex;align-items:center;justify-content:center}
.stage{position:relative;display:none;margin:16px;flex:0 0 auto}
#mainCanvas,#overlayCanvas{display:block;position:absolute;left:0;top:0;transform-origin:0 0}
#mainCanvas{z-index:1;background:#fff}
#overlayCanvas{z-index:2;cursor:crosshair;touch-action:none}
.drop-zone{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;width:100%;min-height:500px;cursor:pointer;transition:background .2s;border-radius:3px}
.drop-zone:hover,.drop-zone.over{background:rgba(0,212,255,.05)}
.drop-icon-ring{width:72px;height:72px;border-radius:6px;border:1px solid var(--borderB);display:flex;align-items:center;justify-content:center;font-size:30px;color:var(--text2);transition:all .25s}
.drop-zone:hover .drop-icon-ring{border-color:var(--accent);color:var(--accent);box-shadow:var(--glow)}
.drop-label{font-family:var(--mono);font-size:12px;color:var(--text2);letter-spacing:2px;text-align:center;line-height:2}
.drop-hint{font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:1px}
.hud{position:absolute;bottom:8px;left:10px;font-family:var(--mono);font-size:10px;color:var(--text3);pointer-events:none;letter-spacing:1px;z-index:3}
.loading{position:absolute;inset:0;background:rgba(5,12,24,.88);display:none;flex-direction:column;align-items:center;justify-content:center;gap:16px;z-index:20}
.loading.show{display:flex}
.spinner{width:38px;height:38px;border-radius:50%;border:1px solid var(--border);border-top-color:var(--accent);animation:spin .75s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-txt{font-family:var(--mono);font-size:11px;color:var(--accent);letter-spacing:3px}
.side-panel{display:flex;flex-direction:column;max-height:calc(100vh - 120px);position:sticky;top:16px}
.quick-actions{padding:12px 16px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:1fr 1fr;gap:8px;background:rgba(0,255,170,.025)}
.primary-action{grid-column:1/-1;font-size:12px;letter-spacing:2px;padding:11px 14px}
.status-line{grid-column:1/-1;font-family:var(--mono);font-size:10px;color:var(--text2);letter-spacing:1px;line-height:1.6;min-height:16px}
.side-scroll{overflow:auto}
.sec{border-bottom:1px solid var(--border)}
.form{padding:14px 16px;display:flex;flex-direction:column;gap:11px}
.fl{font-family:var(--mono);font-size:10px;letter-spacing:2px;color:var(--text2);margin-bottom:4px}
.fg{display:flex;flex-direction:column}
input[type=text],textarea,select,input[type=number]{
  background:var(--bg3);border:1px solid rgba(0,212,255,.25);border-radius:3px;color:var(--text);
  font-family:var(--body);font-size:13px;padding:8px 11px;outline:none;transition:border-color .2s;width:100%;
}
input:focus,textarea:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 1px rgba(0,212,255,.2)}
input::placeholder,textarea::placeholder{color:var(--text3)}
textarea{resize:vertical;min-height:70px;line-height:1.55}
select option{background:var(--bg2)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
input[type=color]{width:100%;height:34px;border:1px solid rgba(0,212,255,.25);border-radius:3px;background:var(--bg3);cursor:pointer;padding:2px 3px}
input[type=range]{width:100%;accent-color:var(--accent);cursor:pointer}
.checks{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.check{display:flex;align-items:center;gap:8px;min-height:34px;padding:7px 9px;border:1px solid rgba(0,212,255,.22);border-radius:3px;background:rgba(0,212,255,.05);color:var(--text2);font-family:var(--mono);font-size:10px;letter-spacing:1px;cursor:pointer;user-select:none}
.check input{accent-color:var(--accent)}
.hint-box{padding:10px 12px;border:1px solid rgba(0,212,255,.22);border-radius:3px;background:rgba(0,212,255,.05);font-family:var(--mono);font-size:10px;color:var(--text2);letter-spacing:1px;line-height:1.8}
.region-list{max-height:210px;overflow:auto;padding:8px}
.region-item{padding:9px 10px;border:1px solid transparent;border-radius:3px;margin-bottom:5px;cursor:pointer;display:flex;align-items:center;gap:8px;transition:all .15s;background:rgba(0,212,255,.02)}
.region-item:hover{background:rgba(0,212,255,.08);border-color:var(--border)}
.region-item.active{background:rgba(0,212,255,.14);border-color:var(--borderB)}
.ri-main{min-width:0;flex:1}
.ri-title{font-family:var(--mono);font-size:12px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ri-meta{font-family:var(--mono);font-size:10px;color:var(--text3);margin-top:3px}
.ri-del{border:0;background:transparent;color:var(--danger);font-family:var(--mono);cursor:pointer;font-size:14px;padding:3px 5px}
.empty{padding:26px 16px;text-align:center;font-family:var(--mono);font-size:11px;color:var(--text3);letter-spacing:1px;line-height:2.2}
.notif{position:fixed;top:18px;right:22px;max-width:420px;padding:10px 18px;background:var(--bg2);border:1px solid var(--borderB);border-radius:3px;font-family:var(--mono);font-size:12px;color:var(--accent);z-index:999;transform:translateX(130%);transition:transform .28s;box-shadow:var(--glow);letter-spacing:1px;line-height:1.6}
.notif.show{transform:translateX(0)}
.notif.ok{border-color:rgba(0,255,170,.5);color:var(--success)}
.notif.err{border-color:rgba(255,68,102,.5);color:var(--danger)}
.footer{margin-top:18px;padding-top:16px;border-top:1px solid var(--border);text-align:center;font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:1px;line-height:2.4}
#fileInput{display:none}
</style>
</head>
<body>
<div class="app">
  <header>
    <div>
      <div class="logo-main">IMG TEXT REWRITE</div>
      <div class="logo-sub">// 图片文字修复系统 v2.0 · MANUAL FIRST</div>
    </div>
    <div class="hdr-right">
      <div class="live-dot"><div class="dot"></div>SYSTEM READY</div>
      <div class="badge">LOCAL ONLY</div>
      <div class="badge">NO UPLOAD</div>
      <div class="badge">FILE MODE OK</div>
    </div>
  </header>

  <div class="workspace">
    <div class="panel">
      <div class="c c-tl"></div><div class="c c-tr"></div><div class="c c-bl"></div><div class="c c-br"></div>
      <div class="toolbar">
        <button class="btn" id="btnOpen" onclick="triggerOpen()">📂 打开图片</button>
        <button class="btn warn" id="btnOcr" onclick="runOCR()" disabled>🔍 辅助 OCR</button>
        <button class="btn" id="btnUndo" onclick="undo()" disabled>↩ 撤销</button>
        <button class="btn danger" id="btnReset" onclick="resetAll()" disabled>⟳ 重置</button>
        <button class="btn" id="btnCleanPreview" onclick="toggleCleanPreview()" disabled>👁 成品预览</button>
        <button class="btn ok" id="btnDown" onclick="downloadImage()" disabled>↓ 导出 PNG</button>
        <div style="margin-left:auto;display:flex;align-items:center;gap:10px">
          <span style="font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:1px">工具模式</span>
          <div class="modes">
            <button class="mode-btn on" id="modeDraw" onclick="setMode('draw')">框选</button>
            <button class="mode-btn" id="modeMove" onclick="setMode('move')">移动文字</button>
          </div>
        </div>
      </div>

      <div class="canvas-zone">
        <div class="canvas-wrap" id="canvasWrap">
          <div class="loading" id="loading">
            <div class="spinner"></div>
            <div class="loading-txt" id="loadTxt">PROCESSING...</div>
          </div>
          <div class="drop-zone" id="dropZone" onclick="triggerOpen()">
            <div class="drop-icon-ring">⊕</div>
            <div class="drop-label">拖拽图片到此处<br>或点击选择文件</div>
            <div class="drop-hint">手动框选优先 · 支持 PNG / JPG / WEBP / GIF</div>
          </div>
          <div class="stage" id="stage">
            <canvas id="mainCanvas"></canvas>
            <canvas id="overlayCanvas"></canvas>
          </div>
          <div class="hud" id="hud">// waiting for image</div>
        </div>
      </div>
    </div>

    <div class="panel side-panel">
      <div class="c c-tl"></div><div class="c c-tr"></div>
      <div class="ph">
        <div class="ph-title">CONTROL PANEL</div>
        <div class="badge" id="regionCount">0 区域</div>
      </div>
      <div class="quick-actions">
        <button class="btn ok primary-action" id="btnCleanPreviewSide" onclick="toggleCleanPreview()" disabled>👁 成品预览</button>
        <button class="btn" onclick="setMode('draw')">＋ 新框选</button>
        <button class="btn ok" onclick="downloadImage()" id="btnExportSide" disabled>↓ 导出图片</button>
        <div class="status-line" id="statusLine">打开图片后，直接框选错误文字区域。</div>
      </div>
      <div class="side-scroll">
        <div class="sec">
          <div class="ph"><div class="ph-title" style="font-size:10px">修复区域</div><div class="badge" id="activeBadge">未选择</div></div>
          <div class="region-list" id="regionList">
            <div class="empty">上传图片后<br>拖拽框选错误文字<br>每个框会变成可编辑区域</div>
          </div>
        </div>

        <div class="sec">
          <div class="ph"><div class="ph-title" style="font-size:10px">文字设置</div></div>
          <div class="form">
            <div class="fg">
              <div class="fl">替换文字</div>
              <textarea id="textValue" placeholder="例如 TECHIC&#10;12673134&#10;TCPS3690" oninput="updateActiveFromForm()"></textarea>
            </div>
            <div class="row2">
              <div class="fg"><div class="fl">文字颜色</div><input type="color" id="textColor" value="#d6d6d6" oninput="updateActiveFromForm()"></div>
              <div class="fg"><div class="fl">描边颜色</div><input type="color" id="strokeColor" value="#222222" oninput="updateActiveFromForm()"></div>
            </div>
            <button class="btn" onclick="matchTextColor()">◎ 匹配原文字颜色</button>
            <div class="row2">
              <div class="fg">
                <div class="fl">字号 <span id="fontSizeVal" style="color:var(--accent)">42</span> px</div>
                <input type="range" id="fontSize" min="8" max="180" value="42" oninput="document.getElementById('fontSizeVal').textContent=this.value;updateActiveFromForm()">
              </div>
              <div class="fg">
                <div class="fl">描边 <span id="strokeVal" style="color:var(--accent)">1</span> px</div>
                <input type="range" id="strokeWidth" min="0" max="12" value="1" oninput="document.getElementById('strokeVal').textContent=this.value;updateActiveFromForm()">
              </div>
            </div>
            <div class="row2">
              <div class="fg">
                <div class="fl">字体</div>
                <select id="fontFamily" onchange="updateActiveFromForm()">
                  <option value="'Noto Sans SC',sans-serif">Noto Sans SC</option>
                  <option value="'Arial Black',sans-serif">Arial Black</option>
                  <option value="Arial,sans-serif">Arial</option>
                  <option value="Impact,sans-serif">Impact</option>
                  <option value="monospace">Monospace</option>
                </select>
              </div>
              <div class="fg">
                <div class="fl">对齐</div>
                <select id="textAlign" onchange="updateActiveFromForm()">
                  <option value="center">居中</option>
                  <option value="left">左对齐</option>
                  <option value="right">右对齐</option>
                </select>
              </div>
            </div>
            <div class="checks">
              <label class="check"><input type="checkbox" id="fontBold" checked onchange="updateActiveFromForm()"> 加粗</label>
              <label class="check"><input type="checkbox" id="autoFit" checked onchange="updateActiveFromForm()"> 自动适配</label>
            </div>
          </div>
        </div>

        <div class="sec">
          <div class="ph"><div class="ph-title" style="font-size:10px">位置 / 修补</div></div>
          <div class="form">
            <div class="row2">
              <div class="fg">
                <div class="fl">旋转 <span id="rotVal" style="color:var(--accent)">0</span>°</div>
                <input type="range" id="rotation" min="-180" max="180" value="0" oninput="document.getElementById('rotVal').textContent=this.value;updateActiveFromForm()">
              </div>
              <div class="fg">
                <div class="fl">缩放 <span id="scaleVal" style="color:var(--accent)">100</span>%</div>
                <input type="range" id="textScale" min="20" max="240" value="100" oninput="document.getElementById('scaleVal').textContent=this.value;updateActiveFromForm()">
              </div>
            </div>
            <div class="row2">
              <div class="fg">
                <div class="fl">透明度 <span id="opacityVal" style="color:var(--accent)">100</span>%</div>
                <input type="range" id="opacity" min="5" max="100" value="100" oninput="document.getElementById('opacityVal').textContent=this.value;updateActiveFromForm()">
              </div>
              <div class="fg">
                <div class="fl">修补方式</div>
                <select id="repairMode" onchange="updateActiveFromForm()">
                  <option value="mask">智能擦字</option>
                  <option value="blur">局部模糊</option>
                  <option value="solid">取样纯色</option>
                  <option value="none">不修补</option>
                </select>
              </div>
            </div>
            <div class="row2">
              <div class="fg">
                <div class="fl">擦除强度 <span id="blurVal" style="color:var(--accent)">18</span></div>
                <input type="range" id="blurRadius" min="2" max="40" value="18" oninput="document.getElementById('blurVal').textContent=this.value;updateActiveFromForm()">
              </div>
              <div class="fg">
                <div class="fl">修补颜色</div>
                <input type="color" id="repairColor" value="#202020" oninput="updateActiveFromForm()">
              </div>
            </div>
            <div class="row2">
              <button class="btn" onclick="rotateActive(180)">↻ 倒置文字</button>
              <button class="btn warn" onclick="boostErase()">◎ 强力擦字</button>
            </div>
            <div class="row2">
              <button class="btn danger" onclick="deleteActive()">× 删除区域</button>
            </div>
            <div class="hint-box">
              黑色产品刻字优先用“智能擦字”：只压掉疑似文字像素，避免出现明显矩形色块。
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer">// 本地 Canvas 合成 · 图片不上传 · OCR 只是辅助，手动框选可离线使用</div>
</div>

<div class="notif" id="notif"></div>
<input type="file" id="fileInput" accept="image/*">
<script src="https://cdnjs.cloudflare.com/ajax/libs/tesseract.js/4.1.1/tesseract.min.js"></script>
<script>
var state={
  image:null,imageName:'image',scale:1,displayW:0,displayH:0,
  regions:[],activeRegionId:null,history:[],mode:'draw',
  drag:null,nextId:1,ocrReady:false,cleanPreview:false
};
var MC=document.getElementById('mainCanvas');
var OC=document.getElementById('overlayCanvas');
var ctx=MC.getContext('2d');
var octx=OC.getContext('2d');
var stage=document.getElementById('stage');
var wrap=document.getElementById('canvasWrap');
var dropZone=document.getElementById('dropZone');
var fileInput=document.getElementById('fileInput');
var _nt=null;

function triggerOpen(){fileInput.value='';fileInput.click();}
fileInput.addEventListener('change',function(e){if(e.target.files&&e.target.files[0])loadFile(e.target.files[0]);});
dropZone.addEventListener('dragover',function(e){e.preventDefault();dropZone.classList.add('over');});
dropZone.addEventListener('dragleave',function(){dropZone.classList.remove('over');});
dropZone.addEventListener('drop',function(e){e.preventDefault();dropZone.classList.remove('over');if(e.dataTransfer.files[0])loadFile(e.dataTransfer.files[0]);});

function loadFile(file){
  if(!file.type.startsWith('image/')){notif('请选择图片文件','err');return;}
  var url=URL.createObjectURL(file);
  var img=new Image();
  img.onload=function(){
    state.image=img;state.imageName=(file.name||'image').replace(/\.[^.]+$/,'');
    state.regions=[];state.activeRegionId=null;state.history=[];state.nextId=1;state.mode='draw';
    state.cleanPreview=false;
    setupCanvas();render();renderList();syncForm();setMode('draw');
    dropZone.style.display='none';stage.style.display='block';
    enableButtons(true);
    document.getElementById('hud').textContent=img.width+' x '+img.height+' px';
    setStatus('图片已载入。拖拽框选错误文字区域。');
    notif('图片加载成功，直接框选要替换的文字','ok');
    URL.revokeObjectURL(url);
  };
  img.onerror=function(){notif('图片加载失败','err');};
  img.src=url;
}

function setupCanvas(){
  var img=state.image;
  var maxW=Math.max(320,wrap.clientWidth-56);
  var maxH=Math.max(460,window.innerHeight*.68);
  var s=Math.min(maxW/img.width,maxH/img.height,1);
  state.scale=s;state.displayW=Math.round(img.width*s);state.displayH=Math.round(img.height*s);
  [MC,OC].forEach(function(c){
    c.width=img.width;c.height=img.height;
    c.style.width=state.displayW+'px';c.style.height=state.displayH+'px';
  });
  stage.style.width=state.displayW+'px';
  stage.style.height=state.displayH+'px';
}

function enableButtons(on){
  ['btnOcr','btnReset','btnDown','btnExportSide','btnCleanPreview','btnCleanPreviewSide'].forEach(function(id){document.getElementById(id).disabled=!on;});
  document.getElementById('btnUndo').disabled=!state.history.length;
  updatePreviewButtons();
}

function snapshot(){
  state.history.push(JSON.stringify({
    regions:state.regions,
    activeRegionId:state.activeRegionId,
    nextId:state.nextId
  }));
  if(state.history.length>50)state.history.shift();
  document.getElementById('btnUndo').disabled=false;
}

function undo(){
  if(!state.history.length)return;
  var old=JSON.parse(state.history.pop());
  state.regions=old.regions;state.activeRegionId=old.activeRegionId;state.nextId=old.nextId;
  render();renderList();syncForm();enableButtons(!!state.image);
  notif('已撤销','ok');
}

function resetAll(){
  if(!state.image)return;
  snapshot();
  state.regions=[];state.activeRegionId=null;state.nextId=1;state.cleanPreview=false;
  render();renderList();syncForm();
  setStatus('已重置。可重新框选。');
}

function setMode(mode){
  if(state.cleanPreview){
    state.cleanPreview=false;
    updatePreviewButtons();
    OC.style.pointerEvents='auto';
  }
  state.mode=mode;
  document.getElementById('modeDraw').className='mode-btn'+(mode==='draw'?' on':'');
  document.getElementById('modeMove').className='mode-btn'+(mode==='move'?' on':'');
  OC.style.cursor=mode==='draw'?'crosshair':'move';
  setStatus(mode==='draw'?'框选模式：拖拽圈出错误文字。':'移动模式：拖动文字、缩放点或旋转点。');
  drawOverlay();
}

function activeRegion(){return state.regions.find(function(r){return r.id===state.activeRegionId;})||null;}

function defaultRegion(rect){
  var edge=sampleRectColor(rect,6);
  var textColor=sampleTextColor(rect,edge);
  var edgeLum=luma(edge.r,edge.g,edge.b);
  var textLum=luma(textColor.r,textColor.g,textColor.b);
  var stroke=textLum>edgeLum?'#1a1a1a':'#f1f1f1';
  var size=Math.max(12,Math.min(120,Math.round(rect.h*.55)));
  return {
    id:state.nextId++,rect:rect,text:'',repairMode:'mask',repairColor:rgbToHex(edge.r,edge.g,edge.b),blurRadius:18,
    style:{fontFamily:"'Noto Sans SC',sans-serif",fontSize:size,color:rgbToHex(textColor.r,textColor.g,textColor.b),strokeColor:stroke,strokeWidth:1,bold:true,align:'center',opacity:1,autoFit:true},
    transform:{x:rect.x+rect.w/2,y:rect.y+rect.h/2,scale:1,rotation:0}
  };
}

function addRegion(rect){
  snapshot();
  var r=defaultRegion(rect);
  state.regions.push(r);state.activeRegionId=r.id;
  syncForm();render();renderList();setMode('move');
  notif('已创建区域 '+r.id+'，输入替换文字即可预览','ok');
}

OC.addEventListener('pointerdown',function(e){
  if(!state.image)return;
  e.preventDefault();OC.setPointerCapture(e.pointerId);
  var p=pointerPos(e);
  if(state.mode==='draw'){
    state.drag={type:'draw',start:p,current:p};
    drawOverlay();
    return;
  }
  var hit=hitTest(p);
  if(hit){
    snapshot();
    state.activeRegionId=hit.region.id;syncForm();renderList();
    state.drag={type:hit.type,regionId:hit.region.id,start:p,startTransform:clone(hit.region.transform),startStyle:clone(hit.region.style)};
  }else{
    var r=findRegionAt(p);
    if(r){state.activeRegionId=r.id;syncForm();renderList();drawOverlay();}
  }
});

OC.addEventListener('pointermove',function(e){
  if(!state.drag)return;
  e.preventDefault();
  var p=pointerPos(e);
  if(state.drag.type==='draw'){
    state.drag.current=p;drawOverlay();return;
  }
  var r=activeRegion();
  if(!r||r.id!==state.drag.regionId)return;
  var dx=p.x-state.drag.start.x,dy=p.y-state.drag.start.y;
  if(state.drag.type==='move'){
    r.transform.x=state.drag.startTransform.x+dx;
    r.transform.y=state.drag.startTransform.y+dy;
  }else if(state.drag.type==='scale'){
    var c={x:state.drag.startTransform.x,y:state.drag.startTransform.y};
    var d0=Math.max(8,dist(state.drag.start,c));
    var d1=Math.max(8,dist(p,c));
    r.transform.scale=clamp(state.drag.startTransform.scale*(d1/d0),.2,2.4);
    r.style.fontSize=clamp(Math.round(state.drag.startStyle.fontSize*(d1/d0)),8,180);
    updateFormNumbers(r);
  }else if(state.drag.type==='rotate'){
    var a0=Math.atan2(state.drag.start.y-state.drag.startTransform.y,state.drag.start.x-state.drag.startTransform.x);
    var a1=Math.atan2(p.y-state.drag.startTransform.y,p.x-state.drag.startTransform.x);
    r.transform.rotation=normDeg(state.drag.startTransform.rotation+(a1-a0)*180/Math.PI);
    updateFormNumbers(r);
  }
  render();
});

OC.addEventListener('pointerup',function(e){
  if(!state.drag)return;
  e.preventDefault();try{OC.releasePointerCapture(e.pointerId);}catch(_e){}
  if(state.drag.type==='draw'){
    var a=state.drag.start,b=state.drag.current||a;
    var rect=normalizeRect(a,b);
    state.drag=null;
    if(rect.w>8&&rect.h>8)addRegion(rect);else drawOverlay();
    return;
  }
  state.drag=null;render();renderList();
});
OC.addEventListener('pointercancel',function(){state.drag=null;drawOverlay();});

function pointerPos(e){
  var r=OC.getBoundingClientRect();
  return {
    x:clamp((e.clientX-r.left)*(OC.width/r.width),0,OC.width),
    y:clamp((e.clientY-r.top)*(OC.height/r.height),0,OC.height)
  };
}

function normalizeRect(a,b){
  var x=Math.min(a.x,b.x),y=Math.min(a.y,b.y),w=Math.abs(a.x-b.x),h=Math.abs(a.y-b.y);
  return {x:Math.round(x),y:Math.round(y),w:Math.round(w),h:Math.round(h)};
}

function render(){
  if(!state.image){ctx.clearRect(0,0,MC.width,MC.height);drawOverlay();return;}
  ctx.clearRect(0,0,MC.width,MC.height);
  ctx.drawImage(state.image,0,0);
  state.regions.forEach(function(r){drawRepair(ctx,r);});
  state.regions.forEach(function(r){drawRegionText(ctx,r);});
  drawOverlay();
}

function toggleCleanPreview(){
  if(!state.image){notif('请先打开图片','err');return;}
  state.cleanPreview=!state.cleanPreview;
  OC.style.pointerEvents=state.cleanPreview?'none':'auto';
  updatePreviewButtons();
  render();
  setStatus(state.cleanPreview?'成品预览中：绿色框已隐藏，当前画面就是导出效果。':'已回到编辑模式。');
  notif(state.cleanPreview?'已进入成品预览':'已回到编辑模式',state.cleanPreview?'ok':'');
}

function updatePreviewButtons(){
  var text=state.cleanPreview?'✎ 回到编辑':'👁 成品预览';
  ['btnCleanPreview','btnCleanPreviewSide'].forEach(function(id){
    var el=document.getElementById(id);
    if(el)el.textContent=text;
  });
}

function drawRepair(target,r){
  var rect=clampRect(r.rect,0);
  if(r.repairMode==='none')return;
  if(r.repairMode==='mask'){
    drawMaskedTextRepair(target,r,rect);
    return;
  }
  if(r.repairMode==='solid'){
    target.save();target.fillStyle=r.repairColor;target.fillRect(rect.x,rect.y,rect.w,rect.h);target.restore();return;
  }
  var pad=Math.max(8,Math.round(r.blurRadius*1.8));
  var src=clampRect({x:rect.x-pad,y:rect.y-pad,w:rect.w+pad*2,h:rect.h+pad*2},0);
  var tmp=document.createElement('canvas');tmp.width=src.w;tmp.height=src.h;
  var t=tmp.getContext('2d');
  t.drawImage(target.canvas,src.x,src.y,src.w,src.h,0,0,src.w,src.h);
  target.save();
  featherClip(target,rect,Math.min(18,Math.max(4,Math.round(Math.min(rect.w,rect.h)*.18))));
  target.filter='blur('+r.blurRadius+'px)';
  target.drawImage(tmp,src.x,src.y);
  target.filter='none';
  target.globalAlpha=.16;
  target.fillStyle=r.repairColor;
  target.fillRect(rect.x,rect.y,rect.w,rect.h);
  target.restore();
}

function drawMaskedTextRepair(target,r,rect){
  var img=target.getImageData(rect.x,rect.y,rect.w,rect.h);
  var data=img.data;
  var bg=hexToRgb(r.repairColor)||sampleRectColor(rect,6);
  var fg=sampleTextColor(rect,bg);
  var bgLum=luma(bg.r,bg.g,bg.b);
  var fgLum=luma(fg.r,fg.g,fg.b);
  var textIsLight=fgLum>=bgLum;
  var strength=clamp((r.blurRadius||18)/40,0.05,1);
  var threshold=Math.max(4,Math.min(28,Math.abs(fgLum-bgLum)*(0.34-strength*.22)));
  var mask=new Float32Array(rect.w*rect.h);

  for(var y=0;y<rect.h;y++){
    for(var x=0;x<rect.w;x++){
      var idx=(y*rect.w+x)*4;
      var pr=data[idx],pg=data[idx+1],pb=data[idx+2];
      var lum=luma(pr,pg,pb);
      var lumScore=textIsLight?(lum-bgLum-threshold):(bgLum-lum-threshold);
      var colorScore=colorDist({r:pr,g:pg,b:pb},bg)-(24-strength*18);
      var s=Math.max(lumScore,colorScore*.62)/(42-strength*18);
      mask[y*rect.w+x]=clamp(s,0,1);
    }
  }

  var expanded=expandMask(mask,rect.w,rect.h,Math.max(1,Math.round(1+strength*4)),0.58+strength*.2);

  var radius=Math.max(4,Math.min(18,Math.round(4+r.blurRadius*.42)));
  var original=new Uint8ClampedArray(data);
  for(var y2=0;y2<rect.h;y2++){
    for(var x2=0;x2<rect.w;x2++){
      var m=expanded[y2*rect.w+x2];
      if(m<=.03)continue;
      var rr=0,gg=0,bb=0,n=0;
      for(var yy=-radius;yy<=radius;yy++){
        for(var xx=-radius;xx<=radius;xx++){
          var sx=x2+xx,sy=y2+yy;
          if(sx<0||sy<0||sx>=rect.w||sy>=rect.h)continue;
          if(expanded[sy*rect.w+sx]>.35)continue;
          var si=(sy*rect.w+sx)*4;
          rr+=original[si];gg+=original[si+1];bb+=original[si+2];n++;
        }
      }
      if(!n){
        var near=nearestEdgeColor(original,rect.w,rect.h,x2,y2);
        rr=near.r;gg=near.g;bb=near.b;n=1;
      }
      var di=(y2*rect.w+x2)*4;
      var mix=clamp(m*(0.88+strength*.18),0,1);
      data[di]=Math.round(original[di]*(1-mix)+(rr/n)*mix);
      data[di+1]=Math.round(original[di+1]*(1-mix)+(gg/n)*mix);
      data[di+2]=Math.round(original[di+2]*(1-mix)+(bb/n)*mix);
    }
  }
  if(strength>.45){
    softenMaskedPixels(data,expanded,rect.w,rect.h,Math.round(1+strength*2));
  }
  target.putImageData(img,rect.x,rect.y);
}

function expandMask(mask,w,h,radius,falloff){
  var out=new Float32Array(mask.length);
  for(var y=0;y<h;y++){
    for(var x=0;x<w;x++){
      var best=mask[y*w+x];
      for(var oy=-radius;oy<=radius;oy++){
        for(var ox=-radius;ox<=radius;ox++){
          var nx=x+ox,ny=y+oy;
          if(nx<0||ny<0||nx>=w||ny>=h)continue;
          var d=Math.sqrt(ox*ox+oy*oy);
          if(d>radius)continue;
          var v=mask[ny*w+nx]*(1-(d/(radius+1))*(1-falloff));
          if(v>best)best=v;
        }
      }
      out[y*w+x]=clamp(best,0,1);
    }
  }
  return out;
}

function nearestEdgeColor(data,w,h,x,y){
  var points=[{x:0,y:y},{x:w-1,y:y},{x:x,y:0},{x:x,y:h-1}];
  var best=points[0],bd=1e9;
  points.forEach(function(p){
    var d=Math.abs(p.x-x)+Math.abs(p.y-y);
    if(d<bd){bd=d;best=p;}
  });
  var i=(best.y*w+best.x)*4;
  return {r:data[i],g:data[i+1],b:data[i+2]};
}

function softenMaskedPixels(data,mask,w,h,radius){
  var src=new Uint8ClampedArray(data);
  for(var y=0;y<h;y++){
    for(var x=0;x<w;x++){
      var m=mask[y*w+x];
      if(m<=.08)continue;
      var rr=0,gg=0,bb=0,n=0;
      for(var oy=-radius;oy<=radius;oy++){
        for(var ox=-radius;ox<=radius;ox++){
          var nx=x+ox,ny=y+oy;
          if(nx<0||ny<0||nx>=w||ny>=h)continue;
          var i=(ny*w+nx)*4;
          rr+=src[i];gg+=src[i+1];bb+=src[i+2];n++;
        }
      }
      var di=(y*w+x)*4,mix=Math.min(.38,m*.32);
      data[di]=Math.round(data[di]*(1-mix)+(rr/n)*mix);
      data[di+1]=Math.round(data[di+1]*(1-mix)+(gg/n)*mix);
      data[di+2]=Math.round(data[di+2]*(1-mix)+(bb/n)*mix);
    }
  }
}

function featherClip(target,rect,feather){
  target.beginPath();
  target.rect(rect.x,rect.y,rect.w,rect.h);
  target.clip();
  if(feather<=0)return;
  var g=target.createLinearGradient(rect.x,rect.y,rect.x+rect.w,rect.y);
  g.addColorStop(0,'rgba(255,255,255,.15)');
  g.addColorStop(.08,'rgba(255,255,255,1)');
  g.addColorStop(.92,'rgba(255,255,255,1)');
  g.addColorStop(1,'rgba(255,255,255,.15)');
}

function drawRegionText(target,r){
  if(!r.text.trim())return;
  var st=r.style,tr=r.transform;
  target.save();
  target.translate(tr.x,tr.y);
  target.rotate(tr.rotation*Math.PI/180);
  target.scale(tr.scale,tr.scale);
  target.globalAlpha=st.opacity;
  target.font=fontSpec(st);
  target.textBaseline='middle';target.textAlign=st.align;
  target.fillStyle=st.color;target.strokeStyle=st.strokeColor;target.lineWidth=st.strokeWidth;target.lineJoin='round';
  var box=textBox(r),lines=fitLines(r,box.w);
  var lineH=st.fontSize*1.18;
  var startY=-(lines.length-1)*lineH/2;
  var x=0;
  if(st.align==='left')x=-box.w/2;
  if(st.align==='right')x=box.w/2;
  lines.forEach(function(line,i){
    var y=startY+i*lineH;
    if(st.strokeWidth>0)target.strokeText(line,x,y);
    target.fillText(line,x,y);
  });
  target.restore();
}

function drawOverlay(){
  octx.clearRect(0,0,OC.width,OC.height);
  if(state.cleanPreview)return;
  if(!state.image)return;
  state.regions.forEach(function(r){
    var active=r.id===state.activeRegionId;
    drawRectOutline(r.rect,active?'#00ffaa':'#00d4ff',active?.95:.35);
  });
  if(state.drag&&state.drag.type==='draw'){
    var rect=normalizeRect(state.drag.start,state.drag.current);
    drawRectOutline(rect,'#00d4ff',.95);
    octx.save();octx.fillStyle='rgba(0,212,255,.08)';octx.fillRect(rect.x,rect.y,rect.w,rect.h);octx.restore();
  }
  var r=activeRegion();
  if(r)drawTextControls(r);
}

function drawRectOutline(rect,color,alpha){
  octx.save();octx.globalAlpha=alpha;octx.strokeStyle=color;octx.lineWidth=2/state.scale;octx.setLineDash([8/state.scale,5/state.scale]);octx.strokeRect(rect.x+.5,rect.y+.5,rect.w,rect.h);octx.restore();
}

function drawTextControls(r){
  var b=textBounds(r),pts=boxPoints(b,r.transform);
  octx.save();
  octx.strokeStyle='#00ffaa';octx.lineWidth=2/state.scale;octx.setLineDash([]);
  octx.beginPath();octx.moveTo(pts[0].x,pts[0].y);for(var i=1;i<pts.length;i++)octx.lineTo(pts[i].x,pts[i].y);octx.closePath();octx.stroke();
  var handle=controlHandles(r,b);
  drawHandle(handle.scale.x,handle.scale.y,'#00ffaa');
  drawHandle(handle.rotate.x,handle.rotate.y,'#ffb040');
  octx.beginPath();octx.moveTo(r.transform.x,r.transform.y);octx.lineTo(handle.rotate.x,handle.rotate.y);octx.strokeStyle='#ffb040';octx.stroke();
  octx.fillStyle='#00ffaa';octx.font=Math.max(10,12/state.scale)+'px monospace';octx.fillText('TEXT',r.transform.x+6/state.scale,r.transform.y-8/state.scale);
  octx.restore();
}

function drawHandle(x,y,color){
  var rr=7/state.scale;
  octx.save();octx.fillStyle=color;octx.strokeStyle='#020810';octx.lineWidth=2/state.scale;
  octx.beginPath();octx.arc(x,y,rr,0,Math.PI*2);octx.fill();octx.stroke();octx.restore();
}

function controlHandles(r,b){
  var pts=boxPoints(b,r.transform);
  var topMid=mid(pts[0],pts[1]);
  var angle=r.transform.rotation*Math.PI/180;
  return {
    scale:pts[2],
    rotate:{x:topMid.x+Math.sin(angle)*-42/state.scale,y:topMid.y+Math.cos(angle)*-42/state.scale}
  };
}

function hitTest(p){
  var r=activeRegion();
  if(r){
    var b=textBounds(r),h=controlHandles(r,b);
    if(dist(p,h.rotate)<14/state.scale)return{type:'rotate',region:r};
    if(dist(p,h.scale)<14/state.scale)return{type:'scale',region:r};
    if(pointInTextBox(p,r,b))return{type:'move',region:r};
  }
  for(var i=state.regions.length-1;i>=0;i--){
    var rr=state.regions[i],bb=textBounds(rr);
    if(pointInTextBox(p,rr,bb))return{type:'move',region:rr};
  }
  return null;
}

function findRegionAt(p){
  for(var i=state.regions.length-1;i>=0;i--){
    var r=state.regions[i],q=r.rect;
    if(p.x>=q.x&&p.x<=q.x+q.w&&p.y>=q.y&&p.y<=q.y+q.h)return r;
  }
  return null;
}

function pointInTextBox(p,r,b){
  var inv=toLocal(p,r.transform);
  return inv.x>=-b.w/2&&inv.x<=b.w/2&&inv.y>=-b.h/2&&inv.y<=b.h/2;
}

function textBox(r){return {w:Math.max(30,r.rect.w),h:Math.max(20,r.rect.h)};}
function textBounds(r){
  var box=textBox(r),lines=fitLines(r,box.w),h=Math.max(r.style.fontSize*1.18,lines.length*r.style.fontSize*1.18);
  return {w:Math.max(40,box.w*r.transform.scale),h:Math.max(22,h*r.transform.scale)};
}

function boxPoints(b,tr){
  var hw=b.w/2,hh=b.h/2,raw=[{x:-hw,y:-hh},{x:hw,y:-hh},{x:hw,y:hh},{x:-hw,y:hh}];
  return raw.map(function(p){return fromLocal(p,tr,1);});
}

function toLocal(p,tr){
  var a=-tr.rotation*Math.PI/180,dx=p.x-tr.x,dy=p.y-tr.y;
  return {x:(dx*Math.cos(a)-dy*Math.sin(a))/tr.scale,y:(dx*Math.sin(a)+dy*Math.cos(a))/tr.scale};
}
function fromLocal(p,tr,ignoreScale){
  var s=ignoreScale?1:tr.scale,a=tr.rotation*Math.PI/180,x=p.x*s,y=p.y*s;
  return {x:tr.x+x*Math.cos(a)-y*Math.sin(a),y:tr.y+x*Math.sin(a)+y*Math.cos(a)};
}

function fitLines(r,maxW){
  var st=r.style,text=r.text||'';
  var old=ctx.font;ctx.font=fontSpec(st);
  var lines=[];
  text.replace(/\r/g,'').split('\n').forEach(function(part){
    if(!part){lines.push('');return;}
    if(!st.autoFit){lines.push(part);return;}
    var cur='';
    for(var i=0;i<part.length;i++){
      var next=cur+part[i];
      if(cur&&ctx.measureText(next).width>maxW){lines.push(cur);cur=part[i];}
      else cur=next;
    }
    if(cur)lines.push(cur);
  });
  ctx.font=old;
  return lines.length?lines:[''];
}

function fontSpec(st){return (st.bold?'700 ':'')+st.fontSize+'px '+st.fontFamily;}

function renderList(){
  document.getElementById('regionCount').textContent=state.regions.length+' 区域';
  document.getElementById('activeBadge').textContent=state.activeRegionId?'区域 '+state.activeRegionId:'未选择';
  var el=document.getElementById('regionList');
  if(!state.regions.length){el.innerHTML='<div class="empty">拖拽框选错误文字<br>区域会显示在这里</div>';return;}
  el.innerHTML=state.regions.map(function(r){
    var txt=(r.text||'未输入文字').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return '<div class="region-item '+(r.id===state.activeRegionId?'active':'')+'" onclick="selectRegion('+r.id+')">'
      +'<div class="ri-main"><div class="ri-title">区域 '+r.id+' · '+txt+'</div>'
      +'<div class="ri-meta">'+Math.round(r.rect.w)+'x'+Math.round(r.rect.h)+' · '+Math.round(r.transform.rotation)+'°</div></div>'
      +'<button class="ri-del" onclick="event.stopPropagation();deleteRegion('+r.id+')">×</button></div>';
  }).join('');
}

function selectRegion(id){state.activeRegionId=id;syncForm();render();renderList();setMode('move');}

function syncForm(){
  var r=activeRegion();
  var disabled=!r;
  ['textValue','textColor','strokeColor','fontSize','strokeWidth','fontFamily','textAlign','fontBold','autoFit','rotation','textScale','opacity','repairMode','blurRadius','repairColor'].forEach(function(id){
    document.getElementById(id).disabled=disabled;
  });
  if(!r){
    document.getElementById('textValue').value='';
    setStatus(state.image?'拖拽框选错误文字区域。':'打开图片后开始。');
    return;
  }
  document.getElementById('textValue').value=r.text;
  document.getElementById('textColor').value=r.style.color;
  document.getElementById('strokeColor').value=r.style.strokeColor;
  document.getElementById('fontSize').value=r.style.fontSize;
  document.getElementById('strokeWidth').value=r.style.strokeWidth;
  document.getElementById('fontFamily').value=r.style.fontFamily;
  document.getElementById('textAlign').value=r.style.align;
  document.getElementById('fontBold').checked=r.style.bold;
  document.getElementById('autoFit').checked=r.style.autoFit;
  document.getElementById('rotation').value=Math.round(r.transform.rotation);
  document.getElementById('textScale').value=Math.round(r.transform.scale*100);
  document.getElementById('opacity').value=Math.round(r.style.opacity*100);
  document.getElementById('repairMode').value=r.repairMode;
  document.getElementById('blurRadius').value=r.blurRadius;
  document.getElementById('repairColor').value=r.repairColor;
  updateFormNumbers(r);
  setStatus('区域 '+r.id+' 已选中。输入文字后可拖动、缩放、旋转。');
}

function updateFormNumbers(r){
  document.getElementById('fontSizeVal').textContent=Math.round(r.style.fontSize);
  document.getElementById('strokeVal').textContent=Math.round(r.style.strokeWidth);
  document.getElementById('rotVal').textContent=Math.round(r.transform.rotation);
  document.getElementById('scaleVal').textContent=Math.round(r.transform.scale*100);
  document.getElementById('opacityVal').textContent=Math.round(r.style.opacity*100);
  document.getElementById('blurVal').textContent=Math.round(r.blurRadius);
}

function updateActiveFromForm(){
  var r=activeRegion();if(!r)return;
  if(state.cleanPreview){
    state.cleanPreview=false;
    OC.style.pointerEvents='auto';
    updatePreviewButtons();
  }
  r.text=document.getElementById('textValue').value;
  r.style.color=document.getElementById('textColor').value;
  r.style.strokeColor=document.getElementById('strokeColor').value;
  r.style.fontSize=parseInt(document.getElementById('fontSize').value,10)||24;
  r.style.strokeWidth=parseInt(document.getElementById('strokeWidth').value,10)||0;
  r.style.fontFamily=document.getElementById('fontFamily').value;
  r.style.align=document.getElementById('textAlign').value;
  r.style.bold=document.getElementById('fontBold').checked;
  r.style.autoFit=document.getElementById('autoFit').checked;
  r.transform.rotation=parseInt(document.getElementById('rotation').value,10)||0;
  r.transform.scale=(parseInt(document.getElementById('textScale').value,10)||100)/100;
  r.style.opacity=(parseInt(document.getElementById('opacity').value,10)||100)/100;
  r.repairMode=document.getElementById('repairMode').value;
  r.blurRadius=parseInt(document.getElementById('blurRadius').value,10)||12;
  r.repairColor=document.getElementById('repairColor').value;
  updateFormNumbers(r);render();renderList();
}

function previewApply(){
  if(!state.image){notif('请先打开图片','err');return;}
  var r=activeRegion();
  if(!r){notif('请先拖拽框选一个区域','err');return;}
  updateActiveFromForm();
  notif('预览已更新，可继续拖动文字或导出','ok');
}

function matchTextColor(){
  var r=activeRegion();
  if(!r){notif('请先选择一个区域','err');return;}
  var bg=sampleRectColor(r.rect,6);
  var fg=sampleTextColor(r.rect,bg);
  r.style.color=rgbToHex(fg.r,fg.g,fg.b);
  r.style.strokeColor=luma(fg.r,fg.g,fg.b)>luma(bg.r,bg.g,bg.b)?'#1a1a1a':'#f1f1f1';
  syncForm();
  render();
  renderList();
  notif('已按框内原文字估算颜色','ok');
}

function boostErase(){
  var r=activeRegion();
  if(!r){notif('请先选择一个区域','err');return;}
  r.repairMode='mask';
  r.blurRadius=34;
  document.getElementById('repairMode').value=r.repairMode;
  document.getElementById('blurRadius').value=r.blurRadius;
  updateFormNumbers(r);
  render();
  renderList();
  notif('已开启强力擦字，残影会擦得更重','ok');
}

function rotateActive(deg){
  var r=activeRegion();if(!r){notif('请先选择区域','err');return;}
  snapshot();r.transform.rotation=normDeg(r.transform.rotation+deg);syncForm();render();renderList();
}

function deleteActive(){var r=activeRegion();if(r)deleteRegion(r.id);}
function deleteRegion(id){
  snapshot();
  state.regions=state.regions.filter(function(r){return r.id!==id;});
  if(state.activeRegionId===id)state.activeRegionId=state.regions.length?state.regions[state.regions.length-1].id:null;
  syncForm();render();renderList();notif('已删除区域','ok');
}

function downloadImage(){
  if(!state.image){notif('请先打开图片','err');return;}
  render();
  var a=document.createElement('a');
  a.href=MC.toDataURL('image/png');
  a.download=state.imageName+'_text_fixed_'+Date.now()+'.png';
  a.click();
  notif('PNG 已导出','ok');
}

function getOriginalImageData(rect){
  var r=clampRect(rect,0);
  var tmp=document.createElement('canvas');
  tmp.width=MC.width;tmp.height=MC.height;
  var t=tmp.getContext('2d');
  t.drawImage(state.image,0,0);
  return {rect:r,data:t.getImageData(r.x,r.y,r.w,r.h).data};
}

async function runOCR(){
  if(!state.image){notif('请先打开图片','err');return;}
  if(!window.Tesseract){
    notif('OCR 未加载，手动框选仍可使用','err');
    setStatus('OCR 依赖没有加载成功。请继续使用手动框选。');
    return;
  }
  showLoad('OCR 辅助识别...');
  var worker=null;
  try{
    worker=await Tesseract.createWorker({
      workerPath:'https://cdnjs.cloudflare.com/ajax/libs/tesseract.js/4.1.1/worker.min.js',
      langPath:'https://tessdata.projectnaptha.com/4.0.0',
      corePath:'https://cdnjs.cloudflare.com/ajax/libs/tesseract.js-core/4.0.4/tesseract-core.wasm.js',
      logger:function(m){setLoadTxt(m.status+(m.progress?' '+Math.round(m.progress*100)+'%':''));}
    });
    await worker.loadLanguage('eng+chi_sim');
    await worker.initialize('eng+chi_sim');
    var res=await worker.recognize(MC.toDataURL('image/png'));
    await worker.terminate();
    var words=(res.data.words||[]).filter(function(w){return w.text&&w.text.trim()&&w.confidence>15;});
    if(!words.length){notif('OCR 没识别到可靠文字，建议手动框选','err');return;}
    snapshot();
    words.slice(0,40).forEach(function(w){
      var b=w.bbox,rect={x:b.x0,y:b.y0,w:b.x1-b.x0,h:b.y1-b.y0};
      var r=defaultRegion(rect);r.text=w.text;state.regions.push(r);
    });
    state.activeRegionId=state.regions[state.regions.length-1].id;
    syncForm();render();renderList();notif('OCR 已转换为可编辑区域：'+words.length+' 个','ok');
  }catch(e){
    if(worker){try{await worker.terminate();}catch(_e){}}
    notif('OCR 不可用，建议手动框选','err');
    setStatus('OCR 加载或识别失败。手动框选不受影响。');
  }finally{hideLoad();}
}

function sampleRectColor(rect,pad){
  if(!state.image)return{r:32,g:32,b:32};
  var r=clampRect({x:rect.x-pad,y:rect.y-pad,w:rect.w+pad*2,h:rect.h+pad*2},0);
  var src=getOriginalImageData(r);
  var data=src.data;
  var rr=0,gg=0,bb=0,n=0;
  for(var y=0;y<r.h;y++){
    for(var x=0;x<r.w;x++){
      var edge=y<4||x<4||y>=r.h-4||x>=r.w-4;if(!edge)continue;
      var i=(y*r.w+x)*4;rr+=data[i];gg+=data[i+1];bb+=data[i+2];n++;
    }
  }
  return n?{r:Math.round(rr/n),g:Math.round(gg/n),b:Math.round(bb/n)}:{r:32,g:32,b:32};
}

function sampleTextColor(rect,bg){
  if(!state.image)return{r:214,g:214,b:214};
  var src=getOriginalImageData(rect);
  var r=src.rect,data=src.data;
  var scores=[];
  for(var y=0;y<r.h;y++){
    for(var x=0;x<r.w;x++){
      var i=(y*r.w+x)*4;
      var pr=data[i],pg=data[i+1],pb=data[i+2],pa=data[i+3];
      if(pa<20)continue;
      var contrast=colorDist({r:pr,g:pg,b:pb},bg);
      var lumDelta=Math.abs(luma(pr,pg,pb)-luma(bg.r,bg.g,bg.b));
      if(contrast>18||lumDelta>16)scores.push({r:pr,g:pg,b:pb,score:contrast+lumDelta});
    }
  }
  if(!scores.length){
    return luma(bg.r,bg.g,bg.b)>128?{r:28,g:28,b:28}:{r:226,g:226,b:226};
  }
  scores.sort(function(a,b){return b.score-a.score;});
  var take=Math.max(8,Math.min(scores.length,Math.round(scores.length*.18)));
  var rr=0,gg=0,bb=0,weight=0;
  for(var j=0;j<take;j++){
    var w=1+(scores[j].score/(scores[0].score||1));
    rr+=scores[j].r*w;gg+=scores[j].g*w;bb+=scores[j].b*w;weight+=w;
  }
  return {r:Math.round(rr/weight),g:Math.round(gg/weight),b:Math.round(bb/weight)};
}

function clampRect(rect,pad){
  pad=pad||0;
  var x=clamp(Math.round(rect.x-pad),0,MC.width),y=clamp(Math.round(rect.y-pad),0,MC.height);
  var x2=clamp(Math.round(rect.x+rect.w+pad),0,MC.width),y2=clamp(Math.round(rect.y+rect.h+pad),0,MC.height);
  return{x:x,y:y,w:Math.max(1,x2-x),h:Math.max(1,y2-y)};
}
function clone(v){return JSON.parse(JSON.stringify(v));}
function clamp(v,min,max){return Math.max(min,Math.min(max,v));}
function dist(a,b){var dx=a.x-b.x,dy=a.y-b.y;return Math.sqrt(dx*dx+dy*dy);}
function mid(a,b){return{x:(a.x+b.x)/2,y:(a.y+b.y)/2};}
function normDeg(v){while(v>180)v-=360;while(v<-180)v+=360;return Math.round(v);}
function luma(r,g,b){return .299*r+.587*g+.114*b;}
function colorDist(a,b){var dr=a.r-b.r,dg=a.g-b.g,db=a.b-b.b;return Math.sqrt(dr*dr+dg*dg+db*db);}
function rgbToHex(r,g,b){return '#'+[r,g,b].map(function(v){return clamp(v,0,255).toString(16).padStart(2,'0');}).join('');}
function hexToRgb(hex){
  var m=String(hex||'').match(/^#?([0-9a-f]{6})$/i);
  if(!m)return null;
  var n=parseInt(m[1],16);
  return {r:(n>>16)&255,g:(n>>8)&255,b:n&255};
}
function showLoad(t){setLoadTxt(t);document.getElementById('loading').classList.add('show');}
function setLoadTxt(t){document.getElementById('loadTxt').textContent=t;}
function hideLoad(){document.getElementById('loading').classList.remove('show');}
function setStatus(t){document.getElementById('statusLine').textContent=t;}
function notif(msg,type){
  var n=document.getElementById('notif');
  n.textContent=msg;n.className='notif show'+(type?' '+type:'');
  clearTimeout(_nt);_nt=setTimeout(function(){n.className='notif';},3000);
}

document.addEventListener('keydown',function(e){
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'){e.preventDefault();undo();}
  if(e.key==='Enter'&&document.activeElement===document.getElementById('textValue')&&!e.shiftKey){e.preventDefault();previewApply();}
  if(e.key==='Delete'||e.key==='Backspace'){
    if(document.activeElement.tagName==='TEXTAREA'||document.activeElement.tagName==='INPUT')return;
    deleteActive();
  }
});

window.addEventListener('resize',function(){
  if(!state.image)return;
  setupCanvas();render();
});

syncForm();
</script>
